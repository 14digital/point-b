# POINT B: one file for the whole app (website + API). Copy to .env at the project root and fill in.
# Production URL of the site, used in email links, e.g. https://pointbmentors.com
WEB_URL=
CORS_ORIGIN=
# Port: cPanel/Passenger sets this itself; leave unset there.
# PORT=3000

# MongoDB. Local dev: `npm run db:local` then use the first URL. Atlas: use your mongodb+srv:// string
# (must be a replica set; Atlas always is) and include the database name, e.g. /pointb.
DATABASE_URL="mongodb://127.0.0.1:27017/pointb?replicaSet=testset"
JWT_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
PAYMENT_WEBHOOK_SECRET="GENERATE_ANOTHER_SECRET"
# Email delivery (optional in development: without SMTP_HOST emails are only logged and shown in-app).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="POINT B Mentors <no-reply@yourdomain.com>"
# Video calls (Daily.co). Create an API key at https://dashboard.daily.co/developers
# Without it, booking still works but the call page shows "not configured".
# DAILY_API_KEY=""
# Card payments (Stripe). Keys: https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY the app uses a demo checkout that charges nothing.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret. Local: `stripe listen --forward-to localhost:4000/api/payments/stripe/webhook`
# prints a whsec_... value. Production: add an endpoint for payment_intent.succeeded in the dashboard.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Video minutes allowance shown in admin (default 10000)
# VIDEO_MINUTES_LIMIT=10000

# WhatsApp alerts for students (WhatsApp Business Cloud API, Meta). Without these, WhatsApp messages are only logged.
# Create an approved message template (default name "pointb_alert", language "en") whose body has three
# parameters, for example:  *{{1}}*  {{2}}  Open: {{3}}
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=pointb_alert
# WHATSAPP_TEMPLATE_LANG=en

# "Match Me" AI matching (Google Gemini). Get a free key at https://aistudio.google.com/apikey
# Without it the Match Me page shows "not set up yet" and everything else works.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
